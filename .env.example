# Copy this file to .env and fill in real values. Never commit .env.
#
# QUICK START FOR TESTING:
# 1. Copy this file: cp .env.example .env
# 2. Fill in GROQ_API_KEY (get from https://console.groq.com)
# 3. Fill in SMTP_USERNAME, SMTP_PASSWORD (Gmail app password)
# 4. Fill in API_KEY (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# 5. Keep LIVE_SENDING_ENABLED=false for first test
# 6. Run: python run.py (in one terminal)
# 7. Run: ./run_e2e_test.sh (in another terminal)

# --- Database ---------------------------------------------------------
# Local dev default. On Render, this is provided automatically by the
# managed Postgres instance (see render.yaml) -- don't set it manually there.
DATABASE_URL=sqlite:///./mailer_agent.db

# --- LLM (Groq) ---------------------------------------------------------
GROQ_API_KEY=
# llama-3.3-70b-versatile was deprecated by Groq in June 2026.
# openai/gpt-oss-120b is the current default primary model.
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=500

# Comma-separated, tried in order (after LLM_MODEL) if the primary model
# hits a transient/eligible-for-failover error -- rate limit, timeout,
# provider 5xx, a fallback model that's been deprecated/renamed
# (model-not-found), or malformed structured output after this patch's
# own strict-schema/json_object/lenient attempts on the primary all
# failed. Never tried for authentication failures or a genuine
# request/schema validation error (see llm/provider_v2.py's
# _classify_error for exactly how those are told apart).
#
# Default is openai/gpt-oss-20b only. Both gpt-oss models are Groq
# PRODUCTION-tier (console.groq.com/docs/models). qwen/qwen3.8-27b has
# the same JSON Schema Mode + reasoning_effort capability but is
# currently a Groq PREVIEW model -- Groq's own guidance is that preview
# models are for evaluation and can be discontinued at short notice, so
# it's deliberately left out of the default production chain. Add it
# explicitly if you want it:
#   LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Do not use qwen/qwen3.6-27b anywhere in this configuration -- it is a
# separate, older model with neither JSON Schema Mode nor multi-level
# reasoning_effort support (only qwen3.8-27b has both).
LLM_FALLBACK_MODELS=openai/gpt-oss-20b

# GPT-OSS models (both 120b and 20b) accept low/medium/high and reject
# "none" outright with a 400 (confirmed against a real request). If you
# add qwen/qwen3.8-27b to LLM_FALLBACK_MODELS, note it additionally
# accepts "none" (its own default) on top of low/medium/high -- but
# whatever you set here is only ever sent to a model whose capability
# entry in llm/provider_v2.py's MODEL_CAPABILITIES says it's valid for
# that specific model; it's silently omitted (with a log warning)
# otherwise, never sent blindly.
LLM_REASONING_EFFORT=low

# --- Outbound mail (SMTP) ------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Inbound mail: LEGACY deployment-global IMAP (non-integrated campaigns) ----
# Mailer Mailboxes created for LeadBoost carry their own encrypted IMAP
# credentials (POST/PATCH /mailboxes) and are polled separately (M3); these
# global values are never used for them. Leave empty if you only use Mailboxes.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=120

# --- Follow-up scheduler --------------------------------------------------
FOLLOWUP_POLL_SECONDS=300
# Set to false when running the API and the scheduler as two separate
# processes/services (e.g. Render Web Service + Background Worker via
# render.yaml) -- true is correct for local dev (`python run.py` alone).
# PRODUCTION API SERVICE: set it to false explicitly. The code default is TRUE, so an unset value
# starts a scheduler inside every Gunicorn worker next to the worker service.
RUN_SCHEDULER_IN_PROCESS=true

# --- Safety toggles --------------------------------------------------------
# Keep both false while testing. Flip LIVE_SENDING_ENABLED once you've
# reviewed draft output in the DB and are ready for real sends.
LIVE_SENDING_ENABLED=false
AUTO_REPLY_ENABLED=false
MAX_SENDS_PER_CYCLE=20
# Gap between consecutive sends within one dispatch batch (initial
# outreach or follow-ups) -- real base delay is this value plus a random
# 0-SEND_JITTER_SECONDS on top, so several contacts don't land in a real
# inbox within the same second or two, which reads as automated bulk
# activity rather than a person sending email.
SEND_DELAY_SECONDS=8
SEND_JITTER_SECONDS=7

# --- API / Multi-tenancy -----------------------------------------------
# Single-tenant (legacy): set API_KEY to one secret; all traffic maps to
# org "default".  This is fine for a single-customer deployment.
API_KEY=

# Multi-tenant: give each calling organization its own key.
# Two equivalent ways to configure this:
#
# Option 1 – JSON map in a single env var (best for secrets managers / CI):
#   ORG_KEY_MAP={"api_key_abc123":"acme","api_key_xyz789":"leadboost"}
#   NOTE: the JSON maps KEY -> ORG ID (the key is what a caller presents in X-API-Key;
#   the value is the organization it is authenticated as). One key per organization.
#   LeadBoost (L1) needs one key per LeadBoost organization, e.g. "<key>":"<leadboost_org_id>".
ORG_KEY_MAP=
#   (LeadBoost's own MAILING_AGENT_ORG_API_KEYS is the INVERSE shape: {"<leadboost_org_id>":"<key>"}.)
#   When ORG_KEY_MAP is used, leave API_KEY empty: a non-empty API_KEY is ALWAYS also accepted
#   as org "default" on every route, including the integration routes.
#
# Option 2 – one env var per org (easier in plain .env files):
#   ORG_KEYS_acme=api_key_abc123
#   ORG_KEYS_leadboost=api_key_xyz789
#
# Resolution order: ORG_KEY_MAP > ORG_KEYS_* > API_KEY
# If none are set, all requests are allowed with org_id="default" (dev-only).

# LeadBoost generated outreach (M2/L1) -- API service only. REQUIRED for that flow: while empty,
# the first generated-outreach dispatch per organization returns 503. This is a single,
# deployment-wide sender persona (known multi-tenant limitation, tracked for C15).
LEADBOOST_INTEGRATION_SENDER_EMAIL=

# --- Mailbox credential encryption (M1) -------------------------------------
# Fernet key encrypting mailbox SMTP/IMAP passwords stored by POST /mailboxes.
# Required only for creating/updating mailbox credentials (503 when unset).
# Generate one (do NOT commit a real value):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing this key makes existing stored mailbox credentials unreadable.
MAILBOX_ENCRYPTION_KEY=

# --- Distributed work claiming (Phase 8) -----------------------------------
# Unique identity for this worker process. If running multiple workers
# simultaneously (e.g., rolling Render deploy), set a distinct value per
# container so logs and expired-lease recovery are traceable to the right
# process. Defaults to "worker-<hostname>" if not set.
WORKER_ID=

# How long (in seconds) a work claim is considered valid before another
# worker may re-claim the contact. Default: 300 (5 minutes). Reduce if
# your job cycle is shorter and you want faster crash recovery.
CLAIM_LEASE_SECONDS=300


# --- E2E Test Configuration (optional overrides) -----------------------
# The run_e2e_test.sh script automatically uses your SMTP settings for
# testing. By default, it sends test emails to yourself (SMTP_USERNAME).
# Override here if you want different test recipients:
#
# SENDER_NAME=Your Name
# SENDER_ORG=Your Organization  
# CONTACT_1_EMAIL=test-recipient@example.com
# LEADBOOST_LEAD_EMAIL=another-test@example.com
#
# For safety, always test with LIVE_SENDING_ENABLED=false first!
